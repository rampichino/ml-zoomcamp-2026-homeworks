            "raw_output": "{\"result\":[{\"cellType\":\"markdown\",\"source\":\"# ML Zoomcamp 2026 \u2014 Homework 5: Deployment\\n\",\"execution_count\":null,\"cell_id\":\"c00\"},{\"cellType\":\"code\",\"source\":\"import hashlib\\nimport json\\nimport os\\nimport subprocess\\nimport time\\nfrom urllib.request import Request, urlopen\\n\\n# use this folder's uv project, not the repo-level .venv\\nos.environ.pop('VIRTUAL_ENV', None)\\n\\n!uv sync --locked -q\\n!uv run python smoke_test.py\",\"execution_count\":1,\"cell_id\":\"c01\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"stream\",\"text\":\"{'conversion_probability': 0.769799, 'conversion': True}\\n\"}]},{\"cellType\":\"markdown\",\"source\":\"## Q1. uv version\",\"execution_count\":null,\"cell_id\":\"c04\"},{\"cellType\":\"code\",\"source\":\"!uv --version\",\"execution_count\":2,\"cell_id\":\"c05\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"stream\",\"text\":\"uv 0.12.5 (x86_64-unknown-linux-gnu)\\n\"}]},{\"cellType\":\"markdown\",\"source\":\"## Q2. Locked Scikit-Learn version\",\"execution_count\":null,\"cell_id\":\"c06\"},{\"cellType\":\"code\",\"source\":\"!grep scikit-learn pyproject.toml\\n!grep -A1 '^name = \\\"scikit-learn\\\"' uv.lock\",\"execution_count\":3,\"cell_id\":\"c07\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"stream\",\"text\":\"    \\\"scikit-learn==1.7.2\\\",\\nname = \\\"scikit-learn\\\"\\nversion = \\\"1.7.2\\\"\\n\"}]},{\"cellType\":\"markdown\",\"source\":\"## Q3. Load the model with pickle\",\"execution_count\":null,\"cell_id\":\"c08\"},{\"cellType\":\"code\",\"source\":\"%%writefile q3_load_model.py\\nimport pickle\\n\\nfrom model import normalize_record\\n\\nlead = {\\n    \\\"lead_source\\\": \\\"paid_ads\\\",\\n    \\\"industry\\\": \\\"technology\\\",\\n    \\\"employment_status\\\": \\\"employed\\\",\\n    \\\"location\\\": \\\"north_america\\\",\\n    \\\"number_of_courses_viewed\\\": 2,\\n    \\\"annual_income\\\": 79276.0,\\n    \\\"interaction_count\\\": 4,\\n    \\\"lead_score\\\": 0.41,\\n}\\n\\nwith open(\\\"pipeline.bin\\\", \\\"rb\\\") as f_in:\\n    pipeline = pickle.load(f_in)\\n\\nprobability = pipeline.predict_proba([normalize_record(lead)])[0, 1]\\nprint(round(float(probability), 3))\",\"execution_count\":4,\"cell_id\":\"c09\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"stream\",\"text\":\"Overwriting q3_load_model.py\\n\"}]},{\"cellType\":\"code\",\"source\":\"!uv run python q3_load_model.py\",\"execution_count\":5,\"cell_id\":\"c10\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"stream\",\"text\":\"0.533\\n\"}]},{\"cellType\":\"markdown\",\"source\":\"## Q4. Serve the model with FastAPI\\nStart `predict:app` with uvicorn in the background, then POST the second lead.\",\"execution_count\":null,\"cell_id\":\"c11\"},{\"cellType\":\"code\",\"source\":\"URL = 'http://localhost:9696'\\nclient = {\\n    'lead_source': 'organic_search',\\n    'industry': 'technology',\\n    'employment_status': 'employed',\\n    'location': 'europe',\\n    'number_of_courses_viewed': 4,\\n    'annual_income': 80304.0,\\n    'interaction_count': 7,\\n    'lead_score': 0.74,\\n}\\n\\ndef wait_for_health(url, timeout=60):\\n    deadline = time.time() + timeout\\n    while time.time() < deadline:\\n        try:\\n            with urlopen(f'{url}/health') as response:\\n                return json.load(response)\\n        except OSError:\\n            time.sleep(0.5)\\n    raise TimeoutError(f'{url} did not become healthy')\\n\\ndef predict(url, lead):\\n    request = Request(f'{url}/predict', data=json.dumps(lead).encode(),\\n                      headers={'Content-Type': 'application/json'}, method='POST')\\n    with urlopen(request) as response:\\n        return json.load(response)\",\"execution_count\":6,\"cell_id\":\"c12\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"server = subprocess.Popen(['uv', 'run', 'uvicorn', 'predict:app', '--host', '0.0.0.0', '--port', '9696'],\\n                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\\ntry:\\n    print(wait_for_health(URL))\\n    result = predict(URL, client)\\nfinally:\\n    server.terminate()\\n    server.wait()\\n\\nresult, round(result['conversion_probability'], 3)\",\"execution_count\":7,\"cell_id\":\"c13\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"stream\",\"text\":\"{'status': 'ok', 'model_sha256': '1646bbdcd38d4f044da6b630c5b332c93a314245a8c21929011c42de51f629f1', 'feature_defaults_sha256': '1694f842b908fac9f53c0cc19be6d91f934befc63af23cc32fefafde69acd0cd'}\\n\"},{\"output_type\":\"execute_result\",\"text\":\"({'conversion_probability': 0.769799, 'conversion': True}, 0.77)\",\"image\":null}]},{\"cellType\":\"markdown\",\"source\":\"## Q5. Python base image\\nThe tag declared in the checked-in `Dockerfile`:\",\"execution_count\":null,\"cell_id\":\"c14\"},{\"cellType\":\"code\",\"source\":\"!head -1 Dockerfile\",\"execution_count\":8,\"cell_id\":\"c15\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"stream\",\"text\":\"FROM python:3.11.15-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3\\n\"}]},{\"cellType\":\"markdown\",\"source\":\"## Q6. Run the container\\n\\nBuild the image and run it in the background, then send the same request as Q4.\\nIt serves the same frozen artifact, so the answer must match Q4.\",\"execution_count\":null,\"cell_id\":\"c16\"},{\"cellType\":\"code\",\"source\":\"!docker build -q -t zoomcamp-model:2026-hw5 .\\n!docker run -d --rm --name hw5 -p 9696:9696 zoomcamp-model:2026-hw5\",\"execution_count\":9,\"cell_id\":\"c17\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"stream\",\"text\":\"sha256:ec6844b0913f66aeb08b8beab49f37e971fd532bb7d430cb3477bdf61da0710e\\n271c86c7f11382d5cb1961ef26055705a1c11207858f85140f16fe1323b8c8df\\n\"}]},{\"cellType\":\"code\",\"source\":\"try:\\n    health = wait_for_health(URL)\\n    assert health['status'] == 'ok' and health['model_sha256'] == expected\\n    print(health)\\n    result = predict(URL, client)\\nfinally:\\n    subprocess.run(['docker', 'stop', 'hw5'], capture_output=True)\\n\\nresult, round(result['conversion_probability'], 3)\",\"execution_count\":10,\"cell_id\":\"c18\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"error\",\"text\":\"NameError: name 'expected' is not defined\\n\\u001b[31m---------------------------------------------------------------------------\\u001b[39m\\n\\u001b[31mNameError\\u001b[39m                                 Traceback (most recent call last)\\n\\u001b[36mCell\\u001b[39m\\u001b[36m \\u001b[39m\\u001b[32mIn[10]\\u001b[39m\\u001b[32m, line 7\\u001b[39m\\n\\u001b[32m      3\\u001b[39m     \\u001b[38;5;28;01massert\\u001b[39;00m health[\\u001b[33m'status'\\u001b[39m] == \\u001b[33m'ok'\\u001b[39m \\u001b[38;5;28;01mand\\u001b[39;00m health[\\u001b[33m'model_sha256'\\u001b[39m] == expected\\n\\u001b[32m      4\\u001b[39m     print(health)\\n\\u001b[32m      5\\u001b[39m     result = predict(URL, client)\\n\\u001b[32m      6\\u001b[39m \\u001b[38;5;28;01mfinally\\u001b[39;00m:\\n\\u001b[32m----> \\u001b[39m\\u001b[32m7\\u001b[39m     subprocess.run([\\u001b[33m'docker'\\u001b[39m, \\u001b[33m'stop'\\u001b[39m, \\u001b[33m'hw5'\\u001b[39m], capture_output=\\u001b[38;5;28;01mTrue\\u001b[39;00m)\\n\\u001b[32m      8\\u001b[39m \\n\\u001b[32m      9\\u001b[39m result, round(result[\\u001b[33m'conversion_probability'\\u001b[39m], \\u001b[32m3\\u001b[39m)\\n\\n\\u001b[31mNameError\\u001b[39m: name 'expected' is not defined\"}]},{\"cellType\":\"code\",\"source\":\"\",\"execution_count\":null,\"cell_id\":\"60657c47-2055-4fb2-b18e-5560f62949e3\",\"language\":\"python\"}]}",
